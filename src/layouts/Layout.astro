---
import '../styles/main.css';
import '../styles/hexgrid.css';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Capitals — a word game of hexes and conquest. Spell words, capture territory, and storm your opponent's castle." />
    <title>Capitals</title>
    <!-- A ?session link goes straight to the board: hide the setup screen
         before first paint so it never flashes (game.js lifts this again). -->
    <script is:inline>
      if (/[?&]session=/.test(location.search)) document.documentElement.classList.add('joining');
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
