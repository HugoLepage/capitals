<!-- Flag button + dropdown. The flags and labels are filled in by i18n.js so
     every language definition lives in one place. -->
<div class="lang-picker" id="lang-picker">
  <button
    class="lang-btn"
    id="btn-lang"
    type="button"
    aria-haspopup="listbox"
    aria-expanded="false"
    data-i18n="lang.pick"
    data-i18n-attr="aria-label,title"
  ></button>
  <ul class="lang-menu" id="lang-menu" role="listbox" hidden></ul>
</div>
