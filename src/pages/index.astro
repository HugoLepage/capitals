---
import Layout from '../layouts/Layout.astro';
import HexGrid from '../components/hexgrid.astro';
import History from '../components/history.astro';
import Overlays from '../components/overlays.astro';
import LangPicker from '../components/langpicker.astro';
---

<Layout>
  <div class="app">
    <header class="topbar">
      <h1 class="logo">CAPITALS</h1>
      <div class="topbar-actions">
        <button class="btn ghost small" id="btn-help" type="button" data-i18n="top.help">How to play</button>
        <button class="btn primary small" id="btn-new-game" type="button" data-i18n="top.newGame">New game</button>
        <button class="btn ghost small mp-btn" id="btn-multiplayer" type="button">
          <span class="mp-dot" id="mp-dot" hidden></span>
          <span class="mp-label" id="mp-label" data-i18n="top.signIn">Sign In</span>
          <span class="mp-name" id="mp-name" hidden></span>
        </button>
        <!-- Both icons ship; CSS shows whichever one offers the other theme.
             data-i18n-attr is required — without it applyStaticStrings would
             replace the button's contents with the label text. -->
        <button
          class="btn ghost small theme-btn"
          id="btn-theme"
          type="button"
          aria-pressed="false"
          data-i18n="theme.toggle"
          data-i18n-attr="aria-label,title"
        >
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20 13.5A8.5 8.5 0 0 1 10.5 4a8.5 8.5 0 1 0 9.5 9.5z" />
          </svg>
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="4.2" />
            <path d="M12 2.5v2.2M12 19.3v2.2M4.2 4.2l1.6 1.6M18.2 18.2l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.2 19.8l1.6-1.6M18.2 5.8l1.6-1.6" />
          </svg>
        </button>
        <LangPicker />
      </div>
    </header>

    <main class="game-shell">
      <section class="board-area">
        <div class="turn-banner" id="turn-banner" aria-live="polite"></div>
        <HexGrid />
        <div class="word-bar">
          <div class="word-display empty" id="word-display" data-i18n="word.prompt">Tap letters to spell a word</div>
          <div class="word-actions">
            <span class="word-status" id="word-status"></span>
            <button class="btn ghost small hidden" id="btn-resign" type="button" data-i18n="word.resign">Resign</button>
            <button class="btn ghost small" id="btn-clear" type="button" disabled data-i18n="word.clear">Clear</button>
            <button class="btn primary small" id="btn-play" type="button" disabled data-i18n="word.play">Play word</button>
          </div>
        </div>
      </section>

      <History />
    </main>
  </div>

  <Overlays />
  <div class="toast" id="toast" role="status"></div>
</Layout>

<script>
  import { initGame } from '../scripts/game.js';
  initGame();
</script>
